    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^9.0.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:responsive": "vitest run src/__tests__/responsive/",
    "test:accessibility": "vitest run src/__tests__/accessibility/",
    "test:mobile": "vitest run src/__tests__/mobile/",
    "test:comprehensive": "vitest run src/__tests__/run-comprehensive-tests.ts",
    "test:responsive-a11y": "node scripts/test-responsive-a11y.js",
    "test:responsive-a11y:verbose": "node scripts/test-responsive-a11y.js --verbose",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "i18n:extract": "node src/i18n/scripts/extract-keys.js",
    "i18n:validate": "node src/i18n/scripts/validate-translations.js",
    "i18n:sync": "node src/i18n/scripts/sync-translations.js",
    "i18n:sync:auto": "node src/i18n/scripts/sync-translations.js --non-interactive",
    "i18n:types": "node src/i18n/scripts/generate-types.js",
    "i18n:coverage": "node -e \"import('./src/i18n/management/index.ts').then(m => m.default.generateCoverageReport())\"",
    "i18n:parser": "i18next --config i18next-parser.config.js",
    "i18n:check": "npm run i18n:extract && npm run i18n:validate",
    "i18n:update": "npm run i18n:extract && npm run i18n:sync:auto && npm run i18n:types",
    "i18n:cli": "node src/i18n/scripts/cli.js",
    "test:i18n": "tsx src/i18n/__tests__/run-i18n-tests.ts",
    "test:i18n:coverage": "tsx src/i18n/__tests__/run-i18n-tests.ts --coverage",
    "test:i18n:report": "tsx src/i18n/__tests__/run-i18n-tests.ts --report",
    "test:i18n:ci": "tsx src/i18n/__tests__/run-i18n-tests.ts --ci",
    "test:i18n:verbose": "tsx src/i18n/__tests__/run-i18n-tests.ts --verbose",
    "test:i18n:comprehensive": "vitest run src/i18n/__tests__/comprehensive.test.tsx",
    "test:i18n:critical-flows": "vitest run src/i18n/__tests__/critical-flows.test.tsx",
    "test:i18n:automation": "vitest run src/i18n/__tests__/automation-utils.test.ts",
    "bundle:analyze": "ANALYZE=true vite build",
    "bundle:size": "vite build && node scripts/check-bundle-size.js",
    "perf:check": "node scripts/performance-check.js",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output html --view"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
