# Jídelníček 2.0 Environment Configuration Example
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ROTATE_REFRESH_TOKENS=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jidelnicek
DB_USER=jidelnicek
DB_PASSWORD=your-database-password
# Optional — defaults to DB_PASSWORD if unset. Separate values let you give the
# jidelnicek_app / jidelnicek_readonly roles different passwords than the
# Postgres superuser. Used only on first-volume init by docker/postgres/00_init*.sh.
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
# pgAdmin admin password (used only if you start the docker-compose 'tools' profile).
PGADMIN_PASSWORD=change-me-pgadmin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_MAX_CONNECTIONS=50

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_MAX_AGE=3600

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@jidelnicek.cz
EMAIL_FROM_NAME=Jídelníček 2.0
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# Security Features
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# CSRF Protection
CSRF_ENABLED=true
CSRF_COOKIE_NAME=jidelnicek_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_LENGTH=32
CSRF_MAX_AGE=86400

# Security Headers
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_REPORT_URI=
REFERRER_POLICY=strict-origin-when-cross-origin

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx
UPLOAD_PATH=uploads
SECURE_UPLOADS=true

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=10

# Session
SESSION_COOKIE_NAME=jidelnicek_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=24
MAX_SESSIONS_PER_USER=5

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=jidelnicek-backend

# External Services
BAKALARI_API_URL=
BAKALARI_API_KEY=
BAKALARI_TIMEOUT=30
STRAVA_API_URL=
STRAVA_API_KEY=
STRAVA_TIMEOUT=30

# Payment Gateway
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_TIMEOUT=60

# Feature Flags
FEATURE_STUDENT_ORDERING=true
FEATURE_PARENT_PORTAL=true
FEATURE_NUTRITION_TRACKING=true
FEATURE_ALLERGEN_ALERTS=true
FEATURE_RECIPE_SHARING=false
FEATURE_MEAL_RATINGS=true
FEATURE_MOBILE_APP=false
FEATURE_AI_RECOMMENDATIONS=false

# Scheduled Jobs
ENABLE_SCHEDULED_JOBS=true
MENU_SYNC_CRON=0 6 * * *
ORDER_REMINDER_CRON=0 15 * * *
REPORT_GENERATION_CRON=0 2 * * 1
CLEANUP_CRON=0 3 * * *

# Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=eu-central-1
BACKUP_ENCRYPTION_ENABLED=true

# Performance
CACHE_TTL_SECONDS=300
QUERY_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=60
WORKER_TIMEOUT_SECONDS=120
# Uvicorn worker process count. Defaults to 4 (a reasonable floor for a
# small VPS, roughly 2*CPU+1 on a 2-core box). Tune up on larger hosts;
# pair with --limit-concurrency / --backlog in docker/entrypoint.sh.
# UVICORN_WORKERS=4