# Staging Environment Configuration
# This file contains staging-specific settings

# ===================================
# ENVIRONMENT & DEBUGGING
# ===================================
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# ===================================
# APPLICATION SETTINGS
# ===================================
SECRET_KEY=${STAGING_SECRET_KEY}  # Set via environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_HOST=${STAGING_DB_HOST}
DB_PORT=5432
DB_NAME=jidelnicek_staging
DB_USER=${STAGING_DB_USER}
DB_PASSWORD=${STAGING_DB_PASSWORD}
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_HOST=${STAGING_REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_POOL_MAX_CONNECTIONS=50

# ===================================
# CORS SETTINGS
# ===================================
CORS_ORIGINS=https://staging.jidelnicek.cz,https://staging-admin.jidelnicek.cz

# ===================================
# EMAIL CONFIGURATION
# ===================================
EMAIL_HOST=${STAGING_SMTP_HOST}
EMAIL_PORT=587
EMAIL_USERNAME=${STAGING_SMTP_USER}
EMAIL_PASSWORD=${STAGING_SMTP_PASSWORD}
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# ===================================
# SECURITY SETTINGS
# ===================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# ===================================
# FILE UPLOAD SETTINGS
# ===================================
MAX_UPLOAD_SIZE=10485760  # 10MB
SECURE_UPLOADS=true

# ===================================
# API RATE LIMITING
# ===================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===================================
# SESSION CONFIGURATION
# ===================================
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=24

# ===================================
# MONITORING & ERROR TRACKING
# ===================================
SENTRY_DSN=${STAGING_SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.5  # 50% sampling in staging
OTEL_ENABLED=true
OTEL_ENDPOINT=http://otel-collector:4317

# ===================================
# EXTERNAL SERVICE INTEGRATIONS
# ===================================
BAKALARI_API_URL=https://staging-api.bakalari.cz
BAKALARI_API_KEY=${STAGING_BAKALARI_KEY}
STRAVA_API_URL=https://staging-api.strava.cz
STRAVA_API_KEY=${STAGING_STRAVA_KEY}

# ===================================
# PAYMENT GATEWAY
# ===================================
PAYMENT_GATEWAY_ENABLED=true
PAYMENT_GATEWAY_URL=https://staging.payment-gateway.cz
PAYMENT_GATEWAY_MERCHANT_ID=${STAGING_PAYMENT_MERCHANT_ID}
PAYMENT_GATEWAY_SECRET_KEY=${STAGING_PAYMENT_SECRET}

# ===================================
# FEATURE FLAGS
# ===================================
# Test new features in staging
FEATURE_STUDENT_ORDERING=true
FEATURE_PARENT_PORTAL=true
FEATURE_NUTRITION_TRACKING=true
FEATURE_ALLERGEN_ALERTS=true
FEATURE_RECIPE_SHARING=true
FEATURE_MEAL_RATINGS=true
FEATURE_MOBILE_APP=true
FEATURE_AI_RECOMMENDATIONS=false

# ===================================
# SCHEDULED JOBS
# ===================================
ENABLE_SCHEDULED_JOBS=true

# ===================================
# BACKUP CONFIGURATION
# ===================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7  # Shorter retention in staging
BACKUP_S3_BUCKET=jidelnicek-staging-backups
BACKUP_S3_ACCESS_KEY=${STAGING_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${STAGING_S3_SECRET_KEY}

# ===================================
# PERFORMANCE TUNING
# ===================================
CACHE_TTL_SECONDS=300
QUERY_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=60
WORKER_TIMEOUT_SECONDS=120