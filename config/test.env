# Test Environment Configuration
# This file contains test-specific settings

# ===================================
# ENVIRONMENT & DEBUGGING
# ===================================
ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=DEBUG

# ===================================
# APPLICATION SETTINGS
# ===================================
SECRET_KEY=test-secret-key-for-unit-tests-only!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5  # Short for testing
REFRESH_TOKEN_EXPIRE_DAYS=1

# ===================================
# DATABASE CONFIGURATION
# ===================================
# Use PostgreSQL for tests (with test database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jidelnicek_test
DB_USER=jidelnicek
DB_PASSWORD=test_password
DATABASE_URL=postgresql://jidelnicek:test_password@localhost:5432/jidelnicek_test
DB_POOL_SIZE=1
DB_ECHO=false

# ===================================
# REDIS CONFIGURATION
# ===================================
# Use fakeredis for testing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=9  # Separate DB for tests
REDIS_PASSWORD=
REDIS_POOL_MAX_CONNECTIONS=5

# ===================================
# CORS SETTINGS
# ===================================
CORS_ORIGINS=["http://testserver", "http://localhost:3000"]

# ===================================
# EMAIL CONFIGURATION
# ===================================
# Mock email for tests
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# ===================================
# SECURITY SETTINGS
# ===================================
BCRYPT_ROUNDS=4  # Fast for tests
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=false
PASSWORD_REQUIRE_SPECIAL=false
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=1

# ===================================
# FILE UPLOAD SETTINGS
# ===================================
MAX_UPLOAD_SIZE=1048576  # 1MB for tests
UPLOAD_PATH=test_uploads
SECURE_UPLOADS=false

# ===================================
# API RATE LIMITING
# ===================================
RATE_LIMIT_ENABLED=false  # Disabled for tests

# ===================================
# SESSION CONFIGURATION
# ===================================
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=1

# ===================================
# MONITORING & ERROR TRACKING
# ===================================
SENTRY_DSN=https://test@sentry.io/123456  # Mock URL for tests  
OTEL_ENABLED=false

# ===================================
# EXTERNAL SERVICE INTEGRATIONS
# ===================================
# Mock endpoints for tests
BAKALARI_API_URL=http://mock-bakalari:8000
BAKALARI_API_KEY=test-key
STRAVA_API_URL=http://mock-strava:8000
STRAVA_API_KEY=test-key

# ===================================
# PAYMENT GATEWAY
# ===================================
PAYMENT_GATEWAY_ENABLED=false

# ===================================
# FEATURE FLAGS
# ===================================
# Enable all for testing
FEATURE_STUDENT_ORDERING=true
FEATURE_PARENT_PORTAL=true
FEATURE_NUTRITION_TRACKING=true
FEATURE_ALLERGEN_ALERTS=true
FEATURE_RECIPE_SHARING=true
FEATURE_MEAL_RATINGS=true
FEATURE_MOBILE_APP=true
FEATURE_AI_RECOMMENDATIONS=true

# ===================================
# SCHEDULED JOBS
# ===================================
ENABLE_SCHEDULED_JOBS=false  # No scheduled jobs in tests

# ===================================
# BACKUP CONFIGURATION
# ===================================
BACKUP_ENABLED=false

# ===================================
# PERFORMANCE TUNING
# ===================================
CACHE_TTL_SECONDS=0  # No caching in tests
QUERY_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
WORKER_TIMEOUT_SECONDS=10
