# Production Environment Configuration
# This file contains production-specific settings
# CRITICAL: Ensure all sensitive values are set via environment variables

# ===================================
# ENVIRONMENT & DEBUGGING
# ===================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# ===================================
# APPLICATION SETTINGS
# ===================================
SECRET_KEY=${PROD_SECRET_KEY}  # MUST be set via environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15  # Shorter for security
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_HOST=${PROD_DB_HOST}
DB_PORT=5432
DB_NAME=jidelnicek_prod
DB_USER=${PROD_DB_USER}
DB_PASSWORD=${PROD_DB_PASSWORD}
DB_POOL_SIZE=50
DB_POOL_MAX_OVERFLOW=20
DB_ECHO=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_HOST=${PROD_REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}
REDIS_POOL_MAX_CONNECTIONS=100

# ===================================
# CORS SETTINGS
# ===================================
CORS_ORIGINS=https://jidelnicek.cz,https://www.jidelnicek.cz,https://admin.jidelnicek.cz

# ===================================
# EMAIL CONFIGURATION
# ===================================
EMAIL_HOST=${PROD_SMTP_HOST}
EMAIL_PORT=587
EMAIL_USERNAME=${PROD_SMTP_USER}
EMAIL_PASSWORD=${PROD_SMTP_PASSWORD}
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
EMAIL_MAX_CONNECTIONS=20

# ===================================
# SECURITY SETTINGS
# ===================================
BCRYPT_ROUNDS=14  # Higher for production
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=30

# ===================================
# FILE UPLOAD SETTINGS
# ===================================
MAX_UPLOAD_SIZE=5242880  # 5MB - stricter in production
SECURE_UPLOADS=true

# ===================================
# API RATE LIMITING
# ===================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60  # Stricter limits
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=5

# ===================================
# SESSION CONFIGURATION
# ===================================
SESSION_COOKIE_SECURE=true  # HTTPS only
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict  # Strictest setting
SESSION_LIFETIME_HOURS=8  # Shorter sessions

# ===================================
# MONITORING & ERROR TRACKING
# ===================================
SENTRY_DSN=${PROD_SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% sampling
OTEL_ENABLED=true
OTEL_ENDPOINT=${PROD_OTEL_ENDPOINT}
OTEL_SERVICE_NAME=jidelnicek-backend-prod

# ===================================
# EXTERNAL SERVICE INTEGRATIONS
# ===================================
BAKALARI_API_URL=https://api.bakalari.cz
BAKALARI_API_KEY=${PROD_BAKALARI_KEY}
BAKALARI_TIMEOUT=30
STRAVA_API_URL=https://api.strava.cz
STRAVA_API_KEY=${PROD_STRAVA_KEY}
STRAVA_TIMEOUT=30

# ===================================
# PAYMENT GATEWAY
# ===================================
PAYMENT_GATEWAY_ENABLED=true
PAYMENT_GATEWAY_URL=https://payment-gateway.cz
PAYMENT_GATEWAY_MERCHANT_ID=${PROD_PAYMENT_MERCHANT_ID}
PAYMENT_GATEWAY_SECRET_KEY=${PROD_PAYMENT_SECRET}
PAYMENT_GATEWAY_TIMEOUT=60

# ===================================
# FEATURE FLAGS
# ===================================
# Stable features only in production
FEATURE_STUDENT_ORDERING=true
FEATURE_PARENT_PORTAL=true
FEATURE_NUTRITION_TRACKING=true
FEATURE_ALLERGEN_ALERTS=true
FEATURE_RECIPE_SHARING=false  # Not yet stable
FEATURE_MEAL_RATINGS=true
FEATURE_MOBILE_APP=false  # Not yet released
FEATURE_AI_RECOMMENDATIONS=false  # Still in testing

# ===================================
# SCHEDULED JOBS
# ===================================
ENABLE_SCHEDULED_JOBS=true
MENU_SYNC_CRON="0 6 * * *"
ORDER_REMINDER_CRON="0 15 * * *"
REPORT_GENERATION_CRON="0 2 * * 1"
CLEANUP_CRON="0 3 * * *"

# ===================================
# BACKUP CONFIGURATION
# ===================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=90  # 3 months retention
BACKUP_S3_BUCKET=jidelnicek-prod-backups
BACKUP_S3_ACCESS_KEY=${PROD_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${PROD_S3_SECRET_KEY}
BACKUP_S3_REGION=eu-central-1
BACKUP_ENCRYPTION_ENABLED=true

# ===================================
# PERFORMANCE TUNING
# ===================================
CACHE_TTL_SECONDS=600  # 10 minutes
QUERY_TIMEOUT_SECONDS=15  # Strict timeouts
REQUEST_TIMEOUT_SECONDS=30
WORKER_TIMEOUT_SECONDS=60

# ===================================
# NGINX CONFIGURATION
# ===================================
NGINX_PORT=80
NGINX_SSL_PORT=443