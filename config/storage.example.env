# Storage Configuration Examples
# Copy the relevant section to your .env file

# ====================
# Local Storage Configuration
# ====================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/lib/jidelnicek/storage
STORAGE_COMPRESSION=gzip
STORAGE_MAX_FILE_SIZE=104857600  # 100MB

# ====================
# AWS S3 Storage Configuration
# ====================
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=jidelnicek-exports
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_STORAGE_CLASS=STANDARD
# STORAGE_S3_ENCRYPTION=AES256
# STORAGE_S3_KMS_KEY_ID=  # Optional, for KMS encryption

# For S3-compatible services (MinIO, DigitalOcean Spaces, etc.)
# STORAGE_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.com

# ====================
# Azure Blob Storage Configuration
# ====================
# STORAGE_BACKEND=azure
# STORAGE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=youraccountkey;EndpointSuffix=core.windows.net
# STORAGE_AZURE_CONTAINER=jidelnicek-exports
# STORAGE_AZURE_TIER=Hot  # Hot, Cool, or Archive

# Alternative Azure configuration with account name/key
# STORAGE_AZURE_ACCOUNT_NAME=youraccountname
# STORAGE_AZURE_ACCOUNT_KEY=youraccountkey
# STORAGE_AZURE_CONTAINER=jidelnicek-exports

# Alternative Azure configuration with SAS token
# STORAGE_AZURE_ACCOUNT_NAME=youraccountname
# STORAGE_AZURE_SAS_TOKEN=your-sas-token
# STORAGE_AZURE_CONTAINER=jidelnicek-exports

# ====================
# Common Storage Options
# ====================
# Compression type: none, gzip, bzip2, xz, zip
# STORAGE_COMPRESSION=gzip

# Maximum file size in bytes
# STORAGE_MAX_FILE_SIZE=104857600  # 100MB

# ====================
# Storage Directory Structure
# ====================
# Files are organized as:
# exports/
# ├── 2024/
# │   ├── 01/
# │   │   ├── user123/
# │   │   │   ├── job456/
# │   │   │   │   ├── 20240115_143022_a1b2c3d4_shopping_list.pdf
# │   │   │   │   └── 20240115_143022_a1b2c3d4_shopping_list.pdf.meta.json
# │   │   │   └── direct/  # Files uploaded without job context
# │   │   └── anonymous/   # Files uploaded without user context
# │   └── 02/
# └── 2025/

# ====================
# Performance Recommendations
# ====================
# Local Storage:
# - Use SSD for better performance
# - Consider RAID for redundancy
# - Regular backups recommended

# S3 Storage:
# - Use STANDARD_IA for infrequently accessed files
# - Enable lifecycle policies for automatic archival
# - Consider S3 Transfer Acceleration for large files

# Azure Storage:
# - Use Hot tier for frequently accessed files
# - Use Cool tier for backups (accessed < once per month)
# - Use Archive tier for long-term storage (accessed < once per year)