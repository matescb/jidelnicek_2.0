# Development Environment Configuration
# This file contains development-specific settings

# ===================================
# ENVIRONMENT & DEBUGGING
# ===================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===================================
# APPLICATION SETTINGS
# ===================================
SECRET_KEY=dev-secret-key-32-characters-minimum!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_HOST=db  # Docker service name
DB_PORT=5432
DB_NAME=jidelnicek_dev
DB_USER=jidelnicek_dev
DB_PASSWORD=dev-password-123
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=true  # Log SQL queries in development

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_HOST=redis  # Docker service name
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev-redis-password
REDIS_POOL_MAX_CONNECTIONS=10

# ===================================
# CORS SETTINGS
# ===================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000

# ===================================
# EMAIL CONFIGURATION
# ===================================
EMAIL_HOST=mailhog  # Docker service name
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# ===================================
# SECURITY SETTINGS
# ===================================
BCRYPT_ROUNDS=4  # Faster for development
PASSWORD_MIN_LENGTH=6  # Relaxed for development
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=false
PASSWORD_REQUIRE_SPECIAL=false

# ===================================
# FILE UPLOAD SETTINGS
# ===================================
MAX_UPLOAD_SIZE=52428800  # 50MB for development
SECURE_UPLOADS=false

# ===================================
# API RATE LIMITING
# ===================================
RATE_LIMIT_ENABLED=false  # Disabled for development

# ===================================
# SESSION CONFIGURATION
# ===================================
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=168  # 1 week for development

# ===================================
# MONITORING & ERROR TRACKING
# ===================================
# SENTRY_DSN=  # Usually not needed in development
OTEL_ENABLED=false

# ===================================
# FEATURE FLAGS
# ===================================
# Enable all features in development
FEATURE_STUDENT_ORDERING=true
FEATURE_PARENT_PORTAL=true
FEATURE_NUTRITION_TRACKING=true
FEATURE_ALLERGEN_ALERTS=true
FEATURE_RECIPE_SHARING=true
FEATURE_MEAL_RATINGS=true
FEATURE_MOBILE_APP=true
FEATURE_AI_RECOMMENDATIONS=true

# ===================================
# SCHEDULED JOBS
# ===================================
ENABLE_SCHEDULED_JOBS=false  # Usually disabled in development

# ===================================
# BACKUP CONFIGURATION
# ===================================
BACKUP_ENABLED=false  # No backups in development

# ===================================
# PERFORMANCE TUNING
# ===================================
CACHE_TTL_SECONDS=60  # Shorter cache for development
QUERY_TIMEOUT_SECONDS=60  # More lenient timeouts
REQUEST_TIMEOUT_SECONDS=120
WORKER_TIMEOUT_SECONDS=300